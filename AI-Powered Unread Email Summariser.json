      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst summaries = items.map(item =>\n  String(item.json.output || \"\")\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .split(/\\s+/)\n    .slice(0, 20)\n    .join(\" \")\n).filter(Boolean);\n\nreturn [{\n  json: {\n    subject: \"AI Summary - Latest 5 Unread Emails\",\n    body: summaries.join(\"\\n\"),\n    totalEmails: summaries.length\n  }\n}];\n"
